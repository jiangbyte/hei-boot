# HEI Boot Docker 部署环境变量（复制为 .env 后填写，勿提交 .env）
# cp .env.example .env

# --- 镜像版本（registry.cn-beijing.aliyuncs.com/czbyte，预先 docker build / docker load）---
HEI_BOOT_VERSION=latest
HEI_ADMIN_VERSION=latest
HEI_PORTAL_VERSION=latest

# --- 应用 ---
SERVER_PORT=8000
HEI_ADMIN_PORT=5173
HEI_PORTAL_PORT=5174
SPRING_PROFILES_ACTIVE=prod
SA_TOKEN_COOKIE_SECURE=false
HEI_SECURITY_EXPOSE_ACTUATOR=true

# --- 中间件镜像（默认 Docker Hub 名；国内可配置镜像加速或覆盖下方变量）---
# MYSQL_IMAGE=mysql:8.0.42
# REDIS_IMAGE=redis:7.2.8
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- MySQL ---
MYSQL_PORT=3306
MYSQL_DATABASE=hei_boot
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- MinIO ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- hei-boot 数据源 / 缓存 ---
DB_WRITE_URL=jdbc:mysql://mysql:3306/hei_boot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_WRITE_USERNAME=root
DB_WRITE_PASSWORD=change-me-mysql-root
DB_PASSWORD=change-me-mysql-root
REDIS_HOST=redis

# 与 scripts/db.sql sys_config 密文一致（演示种子）
HEI_CONFIG_CRYPTO_KEY=change-me-fernet-key

JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
